# Local integration service. Copy to .env.local; do not commit credentials.
ADK_BASE_URL=http://127.0.0.1:3425/v1
ADK_MODEL=codex/gpt-6.1-sol
ADK_AUTH=none
# For an authenticated endpoint: remove ADK_AUTH=none and set the named secret.
# ADK_API_KEY_ENV=OPENAI_API_KEY

# AlphaCode: optional SQLite archive path (default: ~/.alphacode/sessions.db).
# ALPHACODE_DB=C:/path/to/alphacode/sessions.db
# Global defaults and instructions: ~/.alphacode/config.yaml and AGENTS.md.
# ALPHACODE_HOME=C:/path/to/alphacode
# ALPHACODE_PERMISSION=ask
# Environment values above override global YAML defaults.
