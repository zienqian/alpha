{
  "name": "@alpha/provider",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p test/tsconfig.json",
    "lint": "bun --bun run eslint src",
    "test": "bun test ./test/provider.test.js --timeout 30000",
    "test:live": "bun test ./integration/openrouter.js"
  },
  "nx": {
    "tags": [
      "layer:provider"
    ]
  },
  "devDependencies": {
    "@types/node": "20.19.43"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
