{
  "name": "@alpha/adk-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "alpha-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "alpha-source": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./fs": {
      "alpha-source": "./src/fs/index.ts",
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./sqlite": {
      "alpha-source": "./src/sqlite/index.ts",
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit",
    "lint": "bun --bun run eslint src test",
    "test": "bun test ./test --timeout 30000"
  },
  "dependencies": {
    "@alpha/adk": "workspace:*"
  },
  "nx": {
    "tags": ["layer:memory"],
    "targets": {
      "typecheck": {
        "dependsOn": ["build"]
      }
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
