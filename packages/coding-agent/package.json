{
  "name": "@alpha/coding-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "alpha-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p test/tsconfig.json",
    "lint": "bun --bun run eslint src",
    "test": "bun test ./test --timeout 30000"
  },
  "nx": {
    "tags": [
      "layer:coding"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@alpha/adk": "workspace:*",
    "@alpha/provider": "workspace:*",
    "zod": "4.6.7",
    "minimatch": "10.2.6",
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@alpha/adk-session": "workspace:*",
    "@types/cross-spawn": "6.0.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
