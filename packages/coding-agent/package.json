{
  "name": "@alpha/coding-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsrs -p tsconfig.json && node scripts/copy-assets.js",
    "typecheck": "tsrs -p tsconfig.json --noEmit && tsrs -p test/tsconfig.json",
    "lint": "eslint src",
    "test": "node test/run.js"
  },
  "nx": { "tags": ["layer:coding"], "targets": { "typecheck": { "dependsOn": ["build"] } } },
  "dependencies": { "@alpha/adk": "workspace:*", "@alpha/provider": "workspace:*", "zod": "4.6.7", "minimatch": "10.2.6" },
  "devDependencies": { "@alpha/adk-session": "workspace:*", "@types/node": "20.19.43" }
}
