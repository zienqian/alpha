{
  "name": "@alpha/coding-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json && bun scripts/copy-assets.js",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p test/tsconfig.json",
    "lint": "bun --bun run eslint src",
    "test": "bun test ./test --timeout 30000"
  },
  "nx": {
    "tags": [
      "layer:coding"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@alpha/adk": "workspace:*",
    "@alpha/provider": "workspace:*",
    "zod": "4.6.7",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@alpha/adk-session": "workspace:*",
    "@types/node": "20.19.43"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
