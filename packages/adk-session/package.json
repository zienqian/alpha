{
  "name": "@alpha/adk-session",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p test/tsconfig.json",
    "lint": "bun --bun run eslint src",
    "test": "bun test ./test --timeout 30000",
    "example": "bun examples/conversation.js"
  },
  "nx": {
    "tags": [
      "layer:session"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@alpha/adk": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=13.0.3 <14"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "20.19.43",
    "better-sqlite3": "13.0.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
