{
  "name": "@alpha/adk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun --bun run tsrs -p tsconfig.json",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p test/tsconfig.json",
    "lint": "bun --bun run eslint src",
    "test": "bun test ./test --timeout 30000",
    "test:live": "bun integration/live.js"
  },
  "nx": {
    "tags": [
      "layer:adk"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@alpha/provider": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "zod": "4.6.7"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
