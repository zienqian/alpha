# Application
APP_NAME=cloud-agent-server
APP_ENV=development

# HTTP Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
# 0s keeps long-lived SSE streams open
SERVER_WRITE_TIMEOUT=0s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# CORS (comma-separated origins, or *)
CORS_ALLOW_ORIGINS=*

# Database
# Local zero-dependency development (pure-Go SQLite):
DB_DRIVER=sqlite
DB_DSN=data/cloud_agent.db
DB_AUTO_MIGRATE=true

# Production PostgreSQL example:
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=postgres password=postgres dbname=cloud_agent port=5432 sslmode=disable TimeZone=UTC
# DB_MAX_IDLE_CONNS=10
# DB_MAX_OPEN_CONNS=50
# DB_CONN_MAX_LIFETIME=1h
