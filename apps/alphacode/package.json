{
  "name": "@alpha/alphacode",
  "version": "0.1.1",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "alphacode": "./bin/alphacode.ts"
  },
  "scripts": {
    "dev": "bun --no-env-file ./bin/alphacode.ts --watch",
    "build": "bun run scripts/build.ts",
    "start": "bun --env-file=../../.env.local run dist/index.js",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit",
    "lint": "bun --bun run eslint src scripts bin test",
    "test": "bun test ./test --timeout 30000",
    "i18n-check": "bun ../../scripts/check-i18n.ts",
    "i18n-types": "bun --bun run i18next-cli types",
    "i18n:report": "bun --bun run x18n check --root .",
    "i18n:review": "bun ../../scripts/check-i18n.ts --record-review"
  },
  "dependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/react": "0.8.1",
    "i18next": "27.0.1",
    "react": "19.3.1",
    "react-i18next": "18.0.1",
    "@alpha/alphacode-app-server": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@alpha/provider": "workspace:*",
    "@alpha/adk-session": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "nx": {
    "tags": [
      "layer:alphacode-cli"
    ]
  }
}
