{
  "name": "@alpha/alphacode",
  "version": "0.0.0",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "alphacode": "./bin/alphacode.ts"
  },
  "scripts": {
    "dev": "bun --no-env-file ./bin/alphacode.ts --watch",
    "build": "bun run scripts/build.ts",
    "start": "bun --env-file=../../.env.local run dist/index.js",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit",
    "lint": "bun --bun run eslint src scripts bin test",
    "test": "bun test ./test --timeout 30000"
  },
  "dependencies": {
    "@alpha/adk": "workspace:*",
    "@alpha/adk-session": "workspace:*",
    "@alpha/coding-agent": "workspace:*",
    "@alpha/provider": "workspace:*",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "solid-js": "1.9.18"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "nx": {
    "tags": [
      "layer:app"
    ]
  }
}
