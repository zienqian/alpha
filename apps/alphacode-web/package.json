{
  "name": "@alpha/alphacode-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../alphacode-app dev:web",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ui:add": "bun --bun run shadcn add",
    "typecheck": "bun --bun run tsrs -p tsconfig.json --noEmit && bun --bun run tsrs -p tsconfig.tools.json --noEmit",
    "lint": "bun --bun run eslint src test vite.config.ts",
    "test": "vitest run",
    "i18n-check": "bun ../../scripts/check-i18n.ts",
    "i18n-types": "bun --bun run i18next-cli types",
    "i18n:report": "bun --bun run x18n check --root .",
    "i18n:review": "bun ../../scripts/check-i18n.ts --record-review"
  },
  "dependencies": {
    "@alpha/adk-trace": "workspace:*",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "5.107.1",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extension-placeholder": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "hast-util-to-html": "9.0.5",
    "i18next": "27.0.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.70.0",
    "marked": "17.0.1",
    "motion": "14.11.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-markdown": "10.1.0",
    "react-virtuoso": "4.18.21",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "26.1.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.6",
    "vitest": "4.1.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  },
  "nx": {
    "tags": [
      "layer:web"
    ]
  }
}
