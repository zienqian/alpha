    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "26.1.0",
    "vite": "8.3.6",
    "vitest": "4.1.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^20.19.0 || >=22.12.0"
  },
