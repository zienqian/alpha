      "description": "低强调工具栏操作。",
      "html": "<button class=\"ds-button ds-ghost\">返回对话</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 10px;border:0;border-radius:var(--radius-md,8px);font:500 12px system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-button:focus-visible{outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 50%,transparent);outline-offset:2px}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-ghost{background:transparent;color:var(--foreground,#252a34)}.ds-ghost:hover{background:var(--accent,#e6ebf2);color:var(--accent-foreground,#283c59)}"
    },
    {
      "name": "描边按钮",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "重试等辅助操作。",
      "html": "<button class=\"ds-button ds-outline\">重试</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 10px;border:0;border-radius:var(--radius-md,8px);font:500 12px system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-button:focus-visible{outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 50%,transparent);outline-offset:2px}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-outline{border:1px solid var(--border,#dce1e9);background:var(--background,#fafbfd);color:var(--foreground,#252a34);box-shadow:0 1px 2px rgb(0 0 0 / 5%)}.ds-outline:hover{background:var(--accent,#e6ebf2);color:var(--accent-foreground,#283c59)}"
    },
    {
      "name": "文本输入",
      "kind": "input",
      "refersTo": "input",
