  "components": [
    {
      "name": "分组搜索",
      "kind": "custom",
      "refersTo": "search-dialog",
      "description": "实色中性搜索弹层，最大 760px / 70dvh；52px 输入行，快捷操作与聊天分组间隔 5px，结果行桌面最小 35px、窄屏 40px，14px 细线图标和右侧纯文字项目名。Ctrl/⌘ N、Ctrl/⌘ O 仅在弹层内触发新聊天与打开文件夹；全文结果保留路径、命中数量与片段，无尾部 Enter 图标或资源分组。",
      "html": "<section class=\"ds-search\" aria-label=\"搜索\"><div class=\"ds-search-input-row\"><svg class=\"ds-search-input-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-input\" aria-label=\"搜索聊天\" placeholder=\"搜索聊天\"/><button class=\"ds-search-close\" aria-label=\"关闭搜索\"><kbd class=\"ds-search-key\">Esc</kbd></button></div><div class=\"ds-search-list\"><div class=\"ds-search-group\"><div class=\"ds-search-group-heading\">快捷操作</div><button class=\"ds-search-item\"><svg class=\"ds-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M16 3l5 5M9 10l8-8 5 5-8 8-6 1z\"/></svg><span class=\"ds-search-title\">新聊天</span><kbd class=\"ds-search-key\">Ctrl+N</kbd></button><button class=\"ds-search-item\"><svg class=\"ds-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 14l1.5-3h14l-3 9H3V5a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2\"/></svg><span class=\"ds-search-title\">打开文件夹</span><kbd class=\"ds-search-key\">Ctrl+O</kbd></button></div><div class=\"ds-search-group\"><div class=\"ds-search-group-heading\">聊天</div><button class=\"ds-search-item ds-search-selected\"><svg class=\"ds-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22z\"/></svg><span class=\"ds-search-title\">界面调整</span><span class=\"ds-search-project\">alpha</span></button></div></div></section>",
      "css": ".ds-search{--ds-search-surface:#f4f4f4;--ds-search-text:#666666;--ds-search-secondary:#858585;--ds-search-selected:var(--accent,#e6e6e6);--ds-search-key:#e5e5e5;display:flex;flex-direction:column;width:min(760px,100%);max-height:70dvh;overflow:hidden;border:1px solid var(--border,#dce1e9);border-radius:12px;corner-shape:round;background:var(--ds-search-surface);color:var(--popover-foreground,#252a34);box-shadow:var(--overlay-shadow,0 18px 48px -12px rgb(24 38 60 / 22%));font-family:system-ui,sans-serif}.dark .ds-search,:host-context(.dark) .ds-search{--ds-search-surface:var(--popover,#292e37);--ds-search-text:var(--popover-foreground,#e7ebf1);--ds-search-secondary:var(--muted-foreground,#a3adbc);--ds-search-selected:var(--accent,#343d4b);--ds-search-key:var(--muted,#2b3039)}.ds-search-input-row{display:flex;align-items:center;flex-shrink:0;gap:10px;min-height:52px;padding:8px 12px;border-bottom:1px solid var(--border,#dce1e9)}.ds-search-input-icon{width:16px;height:16px;flex-shrink:0;color:var(--ds-search-secondary)}.ds-search-input{flex:1;width:100%;min-width:0;padding:0;border:0;background:transparent;color:var(--foreground,#252a34);font:15px/24px system-ui,sans-serif;outline:none}.ds-search-input::placeholder{color:var(--ds-search-text)}.ds-search-list{max-height:min(440px,calc(70dvh - 52px));padding-bottom:8px;overflow-y:auto;overscroll-behavior:contain;scroll-padding-block:8px}.ds-search-group+.ds-search-group{margin-top:5px}.ds-search-group-heading{display:flex;align-items:center;height:30px;padding:6px 10px 4px;color:var(--ds-search-secondary);font-size:12px;line-height:20px}.ds-search-item{display:flex;align-items:center;gap:10px;width:100%;min-height:35px;padding:6px 10px;border:0;border-radius:6px;background:transparent;color:var(--ds-search-text);font:14px/23px system-ui,sans-serif;text-align:left;cursor:pointer}.ds-search-item:hover,.ds-search-selected{background:var(--ds-search-selected);color:var(--foreground,#252a34)}.ds-search-item:focus-visible,.ds-search-close:focus-visible{outline:2px solid var(--ring,#4b7dc4);outline-offset:-2px}.ds-search-item:active{background:color-mix(in oklab,var(--foreground,#252a34) 10%,var(--background,#fff))}.ds-search-icon{width:14px;height:14px;flex-shrink:0}.ds-search-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-search-project{max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ds-search-secondary);font-size:12px;line-height:16px}.ds-search-key{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:17px;padding:0 6px;border-radius:999px;corner-shape:round;background:var(--ds-search-key);color:var(--ds-search-text);font:12px/1 system-ui,sans-serif}.ds-search-close{padding:4px;border:0;border-radius:8px;background:transparent;cursor:pointer}.ds-search-close:hover{background:var(--ds-search-selected)}@media(max-width:639px){.ds-search-input{font-size:16px}.ds-search-item{min-height:40px}.ds-search-project{max-width:80px}}"
    },
    {
