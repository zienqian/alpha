      "html": "<input class=\"ds-input\" aria-label=\"Skill 链接\" placeholder=\"Skill 链接\" />",
      "css": ".ds-input{height:36px;width:100%;padding:4px 12px;border:1px solid var(--input,#d1d9e4);border-radius:var(--radius-md,8px);background:transparent;color:var(--foreground,#252a34);font:14px system-ui,sans-serif;box-shadow:0 1px 2px rgb(0 0 0 / 5%)}.ds-input::placeholder{color:var(--muted-foreground,#616c7b)}.ds-input:focus-visible{outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 50%,transparent);border-color:var(--ring,#4b7dc4)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "磨砂导航",
      "kind": "nav",
