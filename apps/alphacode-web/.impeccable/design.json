      "css": ".ds-skill-add{display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 12px;border:0;border-radius:9999px;corner-shape:round;background:var(--foreground,#252a34);color:var(--background,#fff);font:500 12px system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-skill-add:hover{background:color-mix(in srgb,var(--foreground,#252a34) 90%,transparent)}.ds-skill-add:focus-visible{outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 50%,transparent);outline-offset:2px}.ds-skill-add:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-skill-add{transition:none}}"
    },
    {
