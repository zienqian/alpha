      "refersTo": "composer",
      "description": "实色编辑表面，玻璃不进入编辑内容。",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-editor\" aria-label=\"消息\" placeholder=\"发送消息\"></textarea><div class=\"ds-tools\"><button class=\"ds-send\" aria-label=\"发送\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button></div></div>",
      "css": ".ds-composer{corner-shape:var(--corner-shape,superellipse(1.3));width:min(680px,100%);border:1px solid var(--input,#d1d9e4);border-radius:var(--radius-2xl,18px);background:var(--card,#fff);box-shadow:var(--composer-shadow,0 4px 20px -8px rgb(31 49 77 / 15%));overflow:hidden}.ds-composer:focus-within{border-color:color-mix(in srgb,var(--ring,#4b7dc4) 60%,transparent);outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 15%,transparent)}.ds-editor{display:block;width:100%;min-height:80px;max-height:192px;padding:14px 16px 8px;border:0;background:transparent;color:var(--foreground,#252a34);resize:vertical;font:14px/24px system-ui,sans-serif;outline:none}.ds-editor::placeholder{color:var(--muted-foreground,#616c7b)}.ds-tools{display:flex;justify-content:flex-end;padding:4px 10px 10px}.ds-send{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border:0;border-radius:9999px;background:var(--primary,#3269be);color:var(--primary-foreground,#fff);cursor:pointer}.ds-send:hover{opacity:.9}.ds-send:focus-visible{outline:2px solid var(--ring,#4b7dc4);outline-offset:2px}"
