      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 10px;border:0;border-radius:var(--radius-md,8px);font:500 12px system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-button:focus-visible{outline:2px solid color-mix(in srgb,var(--ring,#4b7dc4) 50%,transparent);outline-offset:2px}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-secondary{background:var(--secondary,#e9edf3);color:var(--secondary-foreground,#343d4b)}.ds-secondary:hover{background:color-mix(in srgb,var(--secondary,#e9edf3) 80%,transparent)}"
    },
