{
  "name": "alpha-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun --bun run nx run-many -t build",
    "typecheck": "bun --bun run nx run-many -t typecheck",
    "lint": "bun --bun run nx run-many -t lint",
    "test": "bun --bun run nx run-many -t test",
    "graph": "bun --bun run nx graph"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "24.0.4",
    "eslint": "10.14.0",
    "nx": "24.0.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
