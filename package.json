{
  "name": "alpha-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --no-env-file ./apps/alphacode/bin/alphacode.ts --watch",
    "dev:web": "bun run --cwd apps/alphacode-web dev",
    "dev:app": "bun run --cwd apps/alphacode-app dev",
    "build:app": "bun run --cwd apps/alphacode-app build",
    "package:app": "bun run --cwd apps/alphacode-app package",
    "test:app": "bun run --cwd apps/alphacode-app test",
    "dev:server": "bun --no-env-file --conditions=alpha-source ./apps/alphacode-app-server/src/main.ts",
    "start:server": "bun --no-env-file ./apps/alphacode-app-server/dist/main.js",
    "build:web": "bun run --cwd apps/alphacode-web build",
    "link:dev": "bun link --cwd apps/alphacode",
    "start": "bun --env-file=.env.local ./apps/alphacode/dist/index.js",
    "build": "bun --bun run nx run-many -t build",
    "typecheck": "bun --bun run nx run-many -t typecheck",
    "lint": "bun --bun run nx run-many -t lint",
    "test": "bun --bun run nx run-many -t test",
    "graph": "bun --bun run nx graph",
    "i18n:check": "bun --bun run tsrs -p scripts/tsconfig.json --noEmit && bun --bun run eslint scripts && bun test ./scripts/i18n-tools.test.ts && bun --bun run nx run-many -t i18n-check",
    "i18n:types": "bun --bun run nx run-many -t i18n-types"
  },
  "trustedDependencies": ["electron"],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "24.0.4",
    "@types/bun": "1.4.4",
    "@x18n/cli": "0.1.13",
    "eslint": "10.14.0",
    "i18next-cli": "1.87.0",
    "nx": "24.0.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
